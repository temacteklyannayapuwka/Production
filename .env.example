# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
# Local development: lets Django's runserver serve files from source static/.
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=new.stavplus.ru,localhost,127.0.0.1
# Canonical public origin. Keep the test subdomain out of search indexes.
PUBLIC_SITE_URL=https://stavplus.ru

# Local development uses SQLite when DB_* variables are omitted.
# Production uses PostgreSQL, so deployment must set every value below.
# DB_ENGINE=django.db.backends.postgresql_psycopg2
# DB_NAME=your_database_name
# DB_USER=your_database_user
# DB_PASSWORD=replace-with-the-database-password
# DB_HOST=localhost
# DB_PORT=5434

# Optional Joomla K2 source. Use a database account with SELECT-only grants.
# K2_DB_HOST=127.0.0.1
# K2_DB_PORT=3306
# K2_DB_NAME=legacy_joomla
# K2_DB_USER=legacy_reader
# K2_DB_PASSWORD=replace-with-a-read-only-password
# K2_DB_PREFIX=jos_
# K2_DB_CHARSET=utf8mb4
# K2_TIME_ZONE=Europe/Moscow
# K2_MEDIA_ROOT=/absolute/path/to/joomla-root
# K2_REPORT_DIR=/absolute/path/to/k2-import-reports

# AI news pipeline. Disabled by default in every environment, including production.
# Create the key in OpenRouter and keep the real value only in deployment secrets.
OPENROUTER_API_KEY=
# Configure only a model verified to support response_format=json_schema.
OPENROUTER_MODEL=
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2
OPENROUTER_MAX_INPUT_CHARS=12000
AI_NEWS_ENABLED=false
# Version 1 remains draft-only and refuses to run if this is set to true.
AUTO_PUBLISH_AI_NEWS=false
